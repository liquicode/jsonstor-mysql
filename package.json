{
	"name": "@liquicode/jsonstor-mysql",
	"version": "0.1.0",
	"description": "A jsonstor adapter which stores documents in a MySql database.",
	"license": "MIT",
	"engines": {
		"node": ">=10.4.0"
	},
	"homepage": "http://jsonstor.liquicode.com",
	"repository": {
		"type": "git",
		"url": "https://github.com/liquicode/jsonstor-mysql"
	},
	"authors": [
		{
			"name": "Andre' G. Bowlin",
			"email": "agbowlin@gmail.com",
			"homepage": "http://liquicode.com"
		}
	],
	"main": "src/jsonstor-mysql.js",
	"types": "./types/jsonstor-mysql.d.ts",
	"exports": {
		".": {
			"types": "./types/jsonstor-mysql.d.ts",
			"import": "./src/jsonstor-mysql.mjs",
			"require": "./src/jsonstor-mysql.js",
			"default": "./src/jsonstor-mysql.js"
		},
		"./package.json": "./package.json"
	},
	"scripts": {
		"publish version": "npx @liquicode/devops --tasks .\\build\\devops.tasks.js publish_version",
		"start new version": "npx @liquicode/devops --tasks .\\build\\devops.tasks.js start_new_version"
	},
	"keywords": [
		"jsonstor",
		"mysql",
		"mysql server",
		"mongo query"
	],
	"devDependencies": {
        "@liquicode/devops": "^0.1.0",
        "webpack": "^5.89.0",
        "webpack-cli": "^5.1.4",
        "webpack-node-externals": "^3.0.0"
	},
	"dependencies": {
        "@liquicode/jsongin": "^0.1.0",
        "@liquicode/jsonstor": "^0.1.0",
		"mysql2": "^3.6.5"
	}
}
